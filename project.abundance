                {
                  "atomType": "Rotate",
                  "x": 0.509920634920635,
                  "y": 0.8607242339832869,
                  "uniqueID": "id-759",
                  "ioValues": [
                    {
                      "name": "geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
