              "uniqueID": "id-5228",
              "ioValues": [
                {
                  "name": "diameter",
                  "ioValue": 600
                }
              ]
            },
            {
              "atomType": "Code",
              "x": 0.35383597883597884,
              "y": 0.2395543175487465,
              "uniqueID": "id-5243",
              "ioValues": [
                {
                  "name": "shapeA",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "shapeB",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
