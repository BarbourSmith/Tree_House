              ],
              "interpreterVersion": 1,
              "code": "/**\n * Tangent-Arc Shrink Wrap\n * =======================\n *\n * Like the built-in \"Shrink Wrap\" atom, this joins two 2D shapes into a single\n * sketch by filling the gap between them. The difference is HOW the gap is\n * bridged: instead of two straight tangent lines, the two shapes are connected\n * with concave biarcs (pairs of circular arcs) that are **tangent to each shape\n * at the point of contact** and bow *into* the gap, so the connection only lives\n * in the empty space between the shapes and never cuts into either one.\n *\n * The two arcs of each biarc guarantee exact tangency at both shape contacts.\n * `bowDepth` (0..1) sets how deeply the connection pinches into the gap: 0 gives\n * an almost straight shrink-wrap bridge, 1 gives the deepest safe waist. It is a\n * normalized amount (not millimetres) so it behaves the same whatever the size\n * of the shapes, and it saturates rather than breaking down at the top end.\n *\n * Inputs:\n *   shapeA, shapeB - the two 2D sketches to connect (order does not matter)\n *   bowDepth       - waist depth, 0 (straight) .. 1 (deepest pinch)\n *   color          - display colour of the resulting sketch\n */\nfunction run(\n  shapeA: Assembly | undefined = undefined,\n  shapeB: Assembly | undefined = undefined,\n  bowDepth: number = 0.5,\n  color: string = \"#5B9BD5\",\n): Assembly {\n  if (!shapeA || !shapeB) {\n    throw new Error(\n      \"Tangent-Arc Shrink Wrap needs two 2D shapes connected to its inputs.\",\n    );\n  }\n\n  // ---------------------------------------------------------------------------\n  // Minimal 2D vector helpers (operate on { x, y } points)\n  // ---------------------------------------------------------------------------\n  type P = { x: number; y: number };\n  const sub = (a: P, b: P): P => ({ x: a.x - b.x, y: a.y - b.y });\n  const add = (a: P, b: P): P => ({ x: a.x + b.x, y: a.y + b.y });\n  const scale = (a: P, s: number): P => ({ x: a.x * s, y: a.y * s });\n  const dot = (a: P, b: P): number => a.x * b.x + a.y * b.y;\n  const cross = (a: P, b: P): number => a.x * b.y - a.y * b.x;\n  const len = (a: P): number => Math.hypot(a.x, a.y);\n  const norm = (a: P): P => {\n    const l = len(a) || 1;\n    return { x: a.x / l, y: a.y / l };\n  };\n  const leftPerp = (a: P): P => ({ x: -a.y, y: a.x });\n  // Orient v so it points in the same half-plane as reference vector ref.\n  const orient = (v: P, ref: P): P => (dot(v, ref) >= 0 ? v : scale(v, -1));\n\n  // ---------------------------------------------------------------------------\n  // Turn a 2D input Assembly into an ordered, counter-clockwise outline polygon.\n  // ---------------------------------------------------------------------------\n  function orderEdges(mesh: any): P[] {\n    // meshEdges returns { lines:[x,y,z,...], edgeGroups:[{start,count,edgeId}] }.\n    // The edge groups are not guaranteed to be in winding order, so stitch them\n    // together end-to-end (same approach as the worker's preparePoints()).\n    const tol = 1e-4;\n    const almostEqual = (p: P, q: P) =>\n      Math.abs(p.x - q.x) < tol && Math.abs(p.y - q.y) < tol;\n    type EStart = { startPoint: P; start: number; steps: number; edgeId: number };\n    let edgeStarts: EStart[] = [];\n    mesh.edgeGroups.forEach((edge: any) => {\n      edgeStarts.push({\n        startPoint: {\n          x: mesh.lines[edge.start * 3],\n          y: mesh.lines[edge.start * 3 + 1],\n        },\n        start: edge.start * 3,\n        steps: edge.count,\n        edgeId: edge.edgeId,\n      });\n      const endIndex = (edge.start + edge.count - 1) * 3;\n      edgeStarts.push({\n        startPoint: { x: mesh.lines[endIndex], y: mesh.lines[endIndex + 1] },\n        start: endIndex,\n        steps: -edge.count,\n        edgeId: edge.edgeId,\n      });\n    });\n\n    const result: P[] = [];\n    if (edgeStarts.length === 0) return result;\n    let currentEdge = edgeStarts[0];\n    let guard = 0;\n    while (edgeStarts.length > 0 && guard++ < 100000) {\n      for (let i = 1; i < Math.abs(currentEdge.steps); i++) {\n        let offset = i * 3;\n        if (currentEdge.steps < 0) offset = -offset;\n        const index = currentEdge.start + offset;\n        const nextPoint = { x: mesh.lines[index], y: mesh.lines[index + 1] };\n        if (\n          result.length === 0 ||\n          !almostEqual(result[result.length - 1], nextPoint)\n        ) {\n          result.push(nextPoint);\n        }\n      }\n      const curId = currentEdge.edgeId;\n      edgeStarts = edgeStarts.filter((e) => e.edgeId !== curId);\n      if (edgeStarts.length === 0) break;\n      const last = result[result.length - 1];\n      const nextEdges = edgeStarts.filter((e) => almostEqual(last, e.startPoint));\n      if (nextEdges.length === 0) break;\n      currentEdge = nextEdges[0];\n    }\n    return result;\n  }\n\n  function outline(asm: Assembly): P[] {\n    const drawing: any = asm.geometry;\n    if (!drawing || typeof drawing.sketchOnPlane !== \"function\") {\n      throw new Error(\n        \"Tangent-Arc Shrink Wrap inputs must be 2D sketches (not 3D solids or wires).\",\n      );\n    }\n    const sketched: any = drawing.sketchOnPlane();\n    if (typeof sketched.face !== \"function\") {\n      throw new Error(\n        \"Tangent-Arc Shrink Wrap needs simple single-region 2D shapes.\",\n      );\n    }\n    const face = sketched.face();\n    const mesh = face\n      .clone()\n      .outerWire()\n      .meshEdges({ tolerance: 0.05, angularTolerance: 0.05 });\n    const pts = orderEdges(mesh);\n    if (pts.length < 3) {\n      throw new Error(\"Could not read the outline of a Tangent-Arc Shrink Wrap input.\");\n    }\n    // Ensure counter-clockwise winding (positive signed area).\n    let area = 0;\n    for (let i = 0; i < pts.length; i++) {\n      area += cross(pts[i], pts[(i + 1) % pts.length]);\n    }\n    if (area < 0) pts.reverse();\n    return pts;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Convex hull (monotone chain) over the combined, source-tagged point set.\n  // The two hull edges that jump between shapes are the two \"bridges\" that a\n  // straight shrink wrap would draw, and their endpoints are the tangent\n  // contact points on each shape.\n  // ---------------------------------------------------------------------------\n  type TP = { p: P; tag: number; idx: number };\n  function hull(points: TP[]): TP[] {\n    const pts = points\n      .slice()\n      .sort((a, b) => a.p.x - b.p.x || a.p.y - b.p.y);\n    const o = (a: P, b: P, c: P) =>\n      (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);\n    const lower: TP[] = [];\n    for (const pt of pts) {\n      while (\n        lower.length >= 2 &&\n        o(lower[lower.length - 2].p, lower[lower.length - 1].p, pt.p) <= 0\n      )\n        lower.pop();\n      lower.push(pt);\n    }\n    const upper: TP[] = [];\n    for (let i = pts.length - 1; i >= 0; i--) {\n      const pt = pts[i];\n      while (\n        upper.length >= 2 &&\n        o(upper[upper.length - 2].p, upper[upper.length - 1].p, pt.p) <= 0\n      )\n        upper.pop();\n      upper.push(pt);\n    }\n    lower.pop();\n    upper.pop();\n    return lower.concat(upper);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Slide a contact point along an outline, from the straight-tangent contact\n  // toward the nearest point. `amount` is a 0..1 fraction of the safe slide\n  // distance; the safe cap keeps the contact in the region where sliding\n  // further always deepens (never reverses) the waist. Returns the slid point,\n  // the outline tangent there (pointing into the gap), and the fractional vertex\n  // index `f` of the slid point (used later to splice the outline).\n  // ---------------------------------------------------------------------------\n  const SAFE_SLIDE = 0.6; // fraction of the arc-to-nearest that stays monotonic\n  function slide(\n    poly: P[],\n    startIdx: number,\n    targetIdx: number,\n    amount: number,\n  ): { pt: P; tan: P; f: number } {\n    const n = poly.length;\n    const pathLen = (dir: number) => {\n      let d = 0;\n      let i = startIdx;\n      let g = 0;\n      while (i !== targetIdx && g++ < n) {\n        const j = (i + dir + n) % n;\n        d += len(sub(poly[j], poly[i]));\n        i = j;\n      }\n      return d;\n    };\n    const dFwd = pathLen(1);\n    const dBwd = pathLen(-1);\n    const dir = dFwd <= dBwd ? 1 : -1;\n    const frac = Math.max(0, Math.min(1, amount));\n    let remaining = frac * SAFE_SLIDE * Math.min(dFwd, dBwd);\n\n    if (remaining < 1e-9) {\n      const nextP = poly[(startIdx + dir + n) % n];\n      return {\n        pt: poly[startIdx],\n        tan: norm(sub(nextP, poly[startIdx])),\n        f: startIdx,\n      };\n    }\n    let i = startIdx;\n    let guard = 0;\n    while (guard++ < n) {\n      const j = (i + dir + n) % n;\n      const seg = sub(poly[j], poly[i]);\n      const segLen = len(seg);\n      if (segLen >= remaining) {\n        const t = remaining / (segLen || 1);\n        return {\n          pt: add(poly[i], scale(seg, t)),\n          tan: norm(seg),\n          f: ((i + dir * t) % n + n) % n,\n        };\n      }\n      remaining -= segLen;\n      i = j;\n    }\n    const nextP = poly[(i + dir + n) % n];\n    return { pt: poly[i], tan: norm(sub(nextP, poly[i])), f: i };\n  }\n\n  // ---------------------------------------------------------------------------\n  // Integer outline vertices strictly between fractional indices fStart and\n  // fEnd, walking whichever way around the polygon does NOT pass avoidIdx (i.e.\n  // the outer side, away from the gap).\n  // ---------------------------------------------------------------------------\n  function arcVerts(\n    poly: P[],\n    fStart: number,\n    fEnd: number,\n    avoidIdx: number,\n  ): P[] {\n    const n = poly.length;\n    const modn = (x: number) => ((x % n) + n) % n;\n    const spanFwd = modn(fEnd - fStart);\n    const relAvoid = modn(avoidIdx - fStart);\n    const fwdHasAvoid = relAvoid > 1e-9 && relAvoid < spanFwd - 1e-9;\n    const res: P[] = [];\n    if (!fwdHasAvoid) {\n      let k = Math.ceil(fStart + 1e-9);\n      let guard = 0;\n      while (modn(k - fStart) < spanFwd - 1e-9 && guard++ <= n) {\n        res.push(poly[modn(k)]);\n        k++;\n      }\n    } else {\n      const spanBwd = modn(fStart - fEnd);\n      let k = Math.floor(fStart - 1e-9);\n      let guard = 0;\n      while (modn(fStart - k) < spanBwd - 1e-9 && guard++ <= n) {\n        res.push(poly[modn(k)]);\n        k--;\n      }\n    }\n    return res;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Midpoint of the circular arc that starts at A with unit tangent t and ends\n  // at Bp. Returns null when the arc is (near) straight -> caller uses a line.\n  // ---------------------------------------------------------------------------\n  function arcMidpoint(A: P, Bp: P, t: P): P | null {\n    const n = leftPerp(t);\n    const ab = sub(A, Bp);\n    const denom = dot(n, ab);\n    if (Math.abs(denom) < 1e-7) return null; // straight\n    const r = -dot(ab, ab) / (2 * denom); // signed radius along n\n    const C = add(A, scale(n, r));\n    const R = Math.abs(r);\n    if (!(R > 1e-9) || !isFinite(R)) return null;\n    const a0 = Math.atan2(A.y - C.y, A.x - C.x);\n    const a1 = Math.atan2(Bp.y - C.y, Bp.x - C.x);\n    // Tangent at A for counter-clockwise motion:\n    const ccwTan = leftPerp(sub(A, C));\n    const goesCCW = dot(ccwTan, t) > 0;\n    let dA = a1 - a0;\n    if (goesCCW) {\n      while (dA <= 0) dA += 2 * Math.PI;\n    } else {\n      while (dA >= 0) dA -= 2 * Math.PI;\n    }\n    const aMid = a0 + dA / 2;\n    return { x: C.x + R * Math.cos(aMid), y: C.y + R * Math.sin(aMid) };\n  }\n\n  // ---------------------------------------------------------------------------\n  // Equal-tangent-length biarc join point. Given the two endpoints and their\n  // forward unit tangents, this closed form returns the join point J of the two\n  // circular arcs that meet with G1 (tangent) continuity. Returns null when the\n  // arc degenerates to a straight line.\n  // ---------------------------------------------------------------------------\n  function biarcJoin(P0: P, t0: P, P1: P, t1: P): P | null {\n    const v = sub(P1, P0);\n    const t = add(t0, t1);\n    const vt = dot(v, t);\n    const denom = 2 * (1 - dot(t0, t1));\n    let d: number;\n    if (Math.abs(denom) < 1e-9) {\n      // Parallel tangents: only a straight line unless there is a lateral offset.\n      if (Math.abs(vt) < 1e-9) return null;\n      d = dot(v, v) / (4 * vt);\n    } else {\n      const disc = vt * vt + denom * dot(v, v);\n      if (disc < 0) return null;\n      d = (-vt + Math.sqrt(disc)) / denom;\n    }\n    if (!isFinite(d) || d <= 1e-9) return null;\n    return add(scale(add(P0, P1), 0.5), scale(sub(t0, t1), d * 0.5));\n  }\n\n  // ---------------------------------------------------------------------------\n  // Draw one biarc from the pen's current position (P0) to P1, tangent to t0 at\n  // P0 and to t1 at P1. Each arc is drawn as the circle tangent to its shape's\n  // outline, so tangency at both shape contacts is exact.\n  // ---------------------------------------------------------------------------\n  function drawBiarc(pen: any, P0: P, t0: P, P1: P, t1: P): void {\n    const J = biarcJoin(P0, t0, P1, t1);\n    if (!J) {\n      pen.lineTo([P1.x, P1.y]);\n      return;\n    }\n    const mid1 = arcMidpoint(P0, J, t0);\n    if (mid1) pen.threePointsArcTo([J.x, J.y], [mid1.x, mid1.y]);\n    else pen.lineTo([J.x, J.y]);\n\n    // Arc 2 is the circle tangent to t1 at P1 (through J) -> exact tangency to B.\n    // t1 is the forward (arriving) tangent, so travelling P1 -> J the departure\n    // tangent is -t1; using it keeps arc 2 the minor (gap-side) arc.\n    const mid2 = arcMidpoint(P1, J, scale(t1, -1));\n    if (mid2) pen.threePointsArcTo([P1.x, P1.y], [mid2.x, mid2.y]);\n    else pen.lineTo([P1.x, P1.y]);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Main\n  // ---------------------------------------------------------------------------\n  const A = outline(shapeA);\n  const B = outline(shapeB);\n\n  const tagged: TP[] = [\n    ...A.map((p, i) => ({ p, tag: 0, idx: i })),\n    ...B.map((p, i) => ({ p, tag: 1, idx: i })),\n  ];\n  const H = hull(tagged);\n\n  // The two hull edges whose endpoints belong to different shapes are the bridges.\n  const bridges: { aIdx: number; bIdx: number }[] = [];\n  for (let i = 0; i < H.length; i++) {\n    const u = H[i];\n    const w = H[(i + 1) % H.length];\n    if (u.tag !== w.tag) {\n      bridges.push({\n        aIdx: u.tag === 0 ? u.idx : w.idx,\n        bIdx: u.tag === 1 ? u.idx : w.idx,\n      });\n    }\n  }\n\n  const straightFuse = () =>\n    new Assembly({\n      geometry: (shapeA!.geometry as any).fuse(shapeB!.geometry),\n      color,\n      tags: [\"shrink-wrap\", \"tangent-arc\"],\n    });\n\n  // Not two clean bridges (e.g. one shape inside the other, or overlapping) -\n  // fall back to a plain fuse.\n  if (bridges.length !== 2) return straightFuse();\n\n  // Nearest points between the two outlines (the narrowest part of the gap).\n  let bestD = Infinity;\n  let naIdx = 0;\n  let nbIdx = 0;\n  for (let i = 0; i < A.length; i++) {\n    for (let j = 0; j < B.length; j++) {\n      const d = dot(sub(A[i], B[j]), sub(A[i], B[j]));\n      if (d < bestD) {\n        bestD = d;\n        naIdx = i;\n        nbIdx = j;\n      }\n    }\n  }\n  bestD = Math.sqrt(bestD);\n  if (bestD < 1e-4) return straightFuse(); // touching / overlapping\n\n  // Slide each bridge's contacts toward the nearest point by bowDepth.\n  const b0 = bridges[0];\n  const b1 = bridges[1];\n  const ca0 = slide(A, b0.aIdx, naIdx, bowDepth);\n  const cb0 = slide(B, b0.bIdx, nbIdx, bowDepth);\n  const ca1 = slide(A, b1.aIdx, naIdx, bowDepth);\n  const cb1 = slide(B, b1.bIdx, nbIdx, bowDepth);\n\n  // Forward tangents (direction of travel along the perimeter).\n  const f0 = sub(cb0.pt, ca0.pt);\n  const tCa0 = orient(ca0.tan, f0);\n  const tCb0 = orient(cb0.tan, f0);\n  const f1 = sub(ca1.pt, cb1.pt);\n  const tCb1 = orient(cb1.tan, f1);\n  const tCa1 = orient(ca1.tan, f1);\n\n  // Trace the full merged perimeter as a single closed sketch (no boolean, so\n  // the biarcs stay exactly tangent to each shape at the contacts):\n  //   A-contact0 --biarc--> B-contact0 --B outer arc--> B-contact1\n  //     --biarc--> A-contact1 --A outer arc--> back to A-contact0\n  const pen = replicad.draw([ca0.pt.x, ca0.pt.y]);\n  drawBiarc(pen, ca0.pt, tCa0, cb0.pt, tCb0);\n  for (const v of arcVerts(B, cb0.f, cb1.f, nbIdx)) pen.lineTo([v.x, v.y]);\n  pen.lineTo([cb1.pt.x, cb1.pt.y]);\n  drawBiarc(pen, cb1.pt, tCb1, ca1.pt, tCa1);\n  for (const v of arcVerts(A, ca1.f, ca0.f, naIdx)) pen.lineTo([v.x, v.y]);\n  const merged = pen.close();\n\n  return new Assembly({\n    geometry: merged,\n    color,\n    tags: [\"shrink-wrap\", \"tangent-arc\"],\n    bom: [...(shapeA.bom || []), ...(shapeB.bom || [])],\n  });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Tangent-Arc Shrink Wrap\n * =======================\n *\n * Like the built-in \"Shrink Wrap\" atom, this joins two 2D shapes into a single\n * sketch by filling the gap between them. The difference is HOW the gap is\n * bridged: instead of two straight tangent lines, the two shapes are connected\n * with concave biarcs (pairs of circular arcs) that are **tangent to each shape\n * at the point of contact** and bow *into* the gap, so the connection only lives\n * in the empty space between the shapes and never cuts into either one.\n *\n * The two arcs of each biarc guarantee exact tangency at both shape contacts.\n * `bowDepth` (0..1) sets how deeply the connection pinches into the gap: 0 gives\n * an almost straight shrink-wrap bridge, 1 gives the deepest safe waist. It is a\n * normalized amount (not millimetres) so it behaves the same whatever the size\n * of the shapes, and it saturates rather than breaking down at the top end.\n *\n * Inputs:\n *   shapeA, shapeB - the two 2D sketches to connect (order does not matter)\n *   bowDepth       - waist depth, 0 (straight) .. 1 (deepest pinch)\n *   color          - display colour of the resulting sketch\n */\nfunction run(shapeA = undefined, shapeB = undefined, bowDepth = 0.5, color = \"#5B9BD5\") {\n    if (!shapeA || !shapeB) {\n        throw new Error(\"Tangent-Arc Shrink Wrap needs two 2D shapes connected to its inputs.\");\n    }\n    const sub = (a, b) => ({ x: a.x - b.x, y: a.y - b.y });\n    const add = (a, b) => ({ x: a.x + b.x, y: a.y + b.y });\n    const scale = (a, s) => ({ x: a.x * s, y: a.y * s });\n    const dot = (a, b) => a.x * b.x + a.y * b.y;\n    const cross = (a, b) => a.x * b.y - a.y * b.x;\n    const len = (a) => Math.hypot(a.x, a.y);\n    const norm = (a) => {\n        const l = len(a) || 1;\n        return { x: a.x / l, y: a.y / l };\n    };\n    const leftPerp = (a) => ({ x: -a.y, y: a.x });\n    // Orient v so it points in the same half-plane as reference vector ref.\n    const orient = (v, ref) => (dot(v, ref) >= 0 ? v : scale(v, -1));\n    // ---------------------------------------------------------------------------\n    // Turn a 2D input Assembly into an ordered, counter-clockwise outline polygon.\n    // ---------------------------------------------------------------------------\n    function orderEdges(mesh) {\n        // meshEdges returns { lines:[x,y,z,...], edgeGroups:[{start,count,edgeId}] }.\n        // The edge groups are not guaranteed to be in winding order, so stitch them\n        // together end-to-end (same approach as the worker's preparePoints()).\n        const tol = 1e-4;\n        const almostEqual = (p, q) => Math.abs(p.x - q.x) < tol && Math.abs(p.y - q.y) < tol;\n        let edgeStarts = [];\n        mesh.edgeGroups.forEach((edge) => {\n            edgeStarts.push({\n                startPoint: {\n                    x: mesh.lines[edge.start * 3],\n                    y: mesh.lines[edge.start * 3 + 1],\n                },\n                start: edge.start * 3,\n                steps: edge.count,\n                edgeId: edge.edgeId,\n            });\n            const endIndex = (edge.start + edge.count - 1) * 3;\n            edgeStarts.push({\n                startPoint: { x: mesh.lines[endIndex], y: mesh.lines[endIndex + 1] },\n                start: endIndex,\n                steps: -edge.count,\n                edgeId: edge.edgeId,\n            });\n        });\n        const result = [];\n        if (edgeStarts.length === 0)\n            return result;\n        let currentEdge = edgeStarts[0];\n        let guard = 0;\n        while (edgeStarts.length > 0 && guard++ < 100000) {\n            for (let i = 1; i < Math.abs(currentEdge.steps); i++) {\n                let offset = i * 3;\n                if (currentEdge.steps < 0)\n                    offset = -offset;\n                const index = currentEdge.start + offset;\n                const nextPoint = { x: mesh.lines[index], y: mesh.lines[index + 1] };\n                if (result.length === 0 ||\n                    !almostEqual(result[result.length - 1], nextPoint)) {\n                    result.push(nextPoint);\n                }\n            }\n            const curId = currentEdge.edgeId;\n            edgeStarts = edgeStarts.filter((e) => e.edgeId !== curId);\n            if (edgeStarts.length === 0)\n                break;\n            const last = result[result.length - 1];\n            const nextEdges = edgeStarts.filter((e) => almostEqual(last, e.startPoint));\n            if (nextEdges.length === 0)\n                break;\n            currentEdge = nextEdges[0];\n        }\n        return result;\n    }\n    function outline(asm) {\n        const drawing = asm.geometry;\n        if (!drawing || typeof drawing.sketchOnPlane !== \"function\") {\n            throw new Error(\"Tangent-Arc Shrink Wrap inputs must be 2D sketches (not 3D solids or wires).\");\n        }\n        const sketched = drawing.sketchOnPlane();\n        if (typeof sketched.face !== \"function\") {\n            throw new Error(\"Tangent-Arc Shrink Wrap needs simple single-region 2D shapes.\");\n        }\n        const face = sketched.face();\n        const mesh = face\n            .clone()\n            .outerWire()\n            .meshEdges({ tolerance: 0.05, angularTolerance: 0.05 });\n        const pts = orderEdges(mesh);\n        if (pts.length < 3) {\n            throw new Error(\"Could not read the outline of a Tangent-Arc Shrink Wrap input.\");\n        }\n        // Ensure counter-clockwise winding (positive signed area).\n        let area = 0;\n        for (let i = 0; i < pts.length; i++) {\n            area += cross(pts[i], pts[(i + 1) % pts.length]);\n        }\n        if (area < 0)\n            pts.reverse();\n        return pts;\n    }\n    function hull(points) {\n        const pts = points\n            .slice()\n            .sort((a, b) => a.p.x - b.p.x || a.p.y - b.p.y);\n        const o = (a, b, c) => (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);\n        const lower = [];\n        for (const pt of pts) {\n            while (lower.length >= 2 &&\n                o(lower[lower.length - 2].p, lower[lower.length - 1].p, pt.p) <= 0)\n                lower.pop();\n            lower.push(pt);\n        }\n        const upper = [];\n        for (let i = pts.length - 1; i >= 0; i--) {\n            const pt = pts[i];\n            while (upper.length >= 2 &&\n                o(upper[upper.length - 2].p, upper[upper.length - 1].p, pt.p) <= 0)\n                upper.pop();\n            upper.push(pt);\n        }\n        lower.pop();\n        upper.pop();\n        return lower.concat(upper);\n    }\n    // ---------------------------------------------------------------------------\n    // Slide a contact point along an outline, from the straight-tangent contact\n    // toward the nearest point. `amount` is a 0..1 fraction of the safe slide\n    // distance; the safe cap keeps the contact in the region where sliding\n    // further always deepens (never reverses) the waist. Returns the slid point,\n    // the outline tangent there (pointing into the gap), and the fractional vertex\n    // index `f` of the slid point (used later to splice the outline).\n    // ---------------------------------------------------------------------------\n    const SAFE_SLIDE = 0.6; // fraction of the arc-to-nearest that stays monotonic\n    function slide(poly, startIdx, targetIdx, amount) {\n        const n = poly.length;\n        const pathLen = (dir) => {\n            let d = 0;\n            let i = startIdx;\n            let g = 0;\n            while (i !== targetIdx && g++ < n) {\n                const j = (i + dir + n) % n;\n                d += len(sub(poly[j], poly[i]));\n                i = j;\n            }\n            return d;\n        };\n        const dFwd = pathLen(1);\n        const dBwd = pathLen(-1);\n        const dir = dFwd <= dBwd ? 1 : -1;\n        const frac = Math.max(0, Math.min(1, amount));\n        let remaining = frac * SAFE_SLIDE * Math.min(dFwd, dBwd);\n        if (remaining < 1e-9) {\n            const nextP = poly[(startIdx + dir + n) % n];\n            return {\n                pt: poly[startIdx],\n                tan: norm(sub(nextP, poly[startIdx])),\n                f: startIdx,\n            };\n        }\n        let i = startIdx;\n        let guard = 0;\n        while (guard++ < n) {\n            const j = (i + dir + n) % n;\n            const seg = sub(poly[j], poly[i]);\n            const segLen = len(seg);\n            if (segLen >= remaining) {\n                const t = remaining / (segLen || 1);\n                return {\n                    pt: add(poly[i], scale(seg, t)),\n                    tan: norm(seg),\n                    f: ((i + dir * t) % n + n) % n,\n                };\n            }\n            remaining -= segLen;\n            i = j;\n        }\n        const nextP = poly[(i + dir + n) % n];\n        return { pt: poly[i], tan: norm(sub(nextP, poly[i])), f: i };\n    }\n    // ---------------------------------------------------------------------------\n    // Integer outline vertices strictly between fractional indices fStart and\n    // fEnd, walking whichever way around the polygon does NOT pass avoidIdx (i.e.\n    // the outer side, away from the gap).\n    // ---------------------------------------------------------------------------\n    function arcVerts(poly, fStart, fEnd, avoidIdx) {\n        const n = poly.length;\n        const modn = (x) => ((x % n) + n) % n;\n        const spanFwd = modn(fEnd - fStart);\n        const relAvoid = modn(avoidIdx - fStart);\n        const fwdHasAvoid = relAvoid > 1e-9 && relAvoid < spanFwd - 1e-9;\n        const res = [];\n        if (!fwdHasAvoid) {\n            let k = Math.ceil(fStart + 1e-9);\n            let guard = 0;\n            while (modn(k - fStart) < spanFwd - 1e-9 && guard++ <= n) {\n                res.push(poly[modn(k)]);\n                k++;\n            }\n        }\n        else {\n            const spanBwd = modn(fStart - fEnd);\n            let k = Math.floor(fStart - 1e-9);\n            let guard = 0;\n            while (modn(fStart - k) < spanBwd - 1e-9 && guard++ <= n) {\n                res.push(poly[modn(k)]);\n                k--;\n            }\n        }\n        return res;\n    }\n    // ---------------------------------------------------------------------------\n    // Midpoint of the circular arc that starts at A with unit tangent t and ends\n    // at Bp. Returns null when the arc is (near) straight -> caller uses a line.\n    // ---------------------------------------------------------------------------\n    function arcMidpoint(A, Bp, t) {\n        const n = leftPerp(t);\n        const ab = sub(A, Bp);\n        const denom = dot(n, ab);\n        if (Math.abs(denom) < 1e-7)\n            return null; // straight\n        const r = -dot(ab, ab) / (2 * denom); // signed radius along n\n        const C = add(A, scale(n, r));\n        const R = Math.abs(r);\n        if (!(R > 1e-9) || !isFinite(R))\n            return null;\n        const a0 = Math.atan2(A.y - C.y, A.x - C.x);\n        const a1 = Math.atan2(Bp.y - C.y, Bp.x - C.x);\n        // Tangent at A for counter-clockwise motion:\n        const ccwTan = leftPerp(sub(A, C));\n        const goesCCW = dot(ccwTan, t) > 0;\n        let dA = a1 - a0;\n        if (goesCCW) {\n            while (dA <= 0)\n                dA += 2 * Math.PI;\n        }\n        else {\n            while (dA >= 0)\n                dA -= 2 * Math.PI;\n        }\n        const aMid = a0 + dA / 2;\n        return { x: C.x + R * Math.cos(aMid), y: C.y + R * Math.sin(aMid) };\n    }\n    // ---------------------------------------------------------------------------\n    // Equal-tangent-length biarc join point. Given the two endpoints and their\n    // forward unit tangents, this closed form returns the join point J of the two\n    // circular arcs that meet with G1 (tangent) continuity. Returns null when the\n    // arc degenerates to a straight line.\n    // ---------------------------------------------------------------------------\n    function biarcJoin(P0, t0, P1, t1) {\n        const v = sub(P1, P0);\n        const t = add(t0, t1);\n        const vt = dot(v, t);\n        const denom = 2 * (1 - dot(t0, t1));\n        let d;\n        if (Math.abs(denom) < 1e-9) {\n            // Parallel tangents: only a straight line unless there is a lateral offset.\n            if (Math.abs(vt) < 1e-9)\n                return null;\n            d = dot(v, v) / (4 * vt);\n        }\n        else {\n            const disc = vt * vt + denom * dot(v, v);\n            if (disc < 0)\n                return null;\n            d = (-vt + Math.sqrt(disc)) / denom;\n        }\n        if (!isFinite(d) || d <= 1e-9)\n            return null;\n        return add(scale(add(P0, P1), 0.5), scale(sub(t0, t1), d * 0.5));\n    }\n    // ---------------------------------------------------------------------------\n    // Draw one biarc from the pen's current position (P0) to P1, tangent to t0 at\n    // P0 and to t1 at P1. Each arc is drawn as the circle tangent to its shape's\n    // outline, so tangency at both shape contacts is exact.\n    // ---------------------------------------------------------------------------\n    function drawBiarc(pen, P0, t0, P1, t1) {\n        const J = biarcJoin(P0, t0, P1, t1);\n        if (!J) {\n            pen.lineTo([P1.x, P1.y]);\n            return;\n        }\n        const mid1 = arcMidpoint(P0, J, t0);\n        if (mid1)\n            pen.threePointsArcTo([J.x, J.y], [mid1.x, mid1.y]);\n        else\n            pen.lineTo([J.x, J.y]);\n        // Arc 2 is the circle tangent to t1 at P1 (through J) -> exact tangency to B.\n        // t1 is the forward (arriving) tangent, so travelling P1 -> J the departure\n        // tangent is -t1; using it keeps arc 2 the minor (gap-side) arc.\n        const mid2 = arcMidpoint(P1, J, scale(t1, -1));\n        if (mid2)\n            pen.threePointsArcTo([P1.x, P1.y], [mid2.x, mid2.y]);\n        else\n            pen.lineTo([P1.x, P1.y]);\n    }\n    // ---------------------------------------------------------------------------\n    // Main\n    // ---------------------------------------------------------------------------\n    const A = outline(shapeA);\n    const B = outline(shapeB);\n    const tagged = [\n        ...A.map((p, i) => ({ p, tag: 0, idx: i })),\n        ...B.map((p, i) => ({ p, tag: 1, idx: i })),\n    ];\n    const H = hull(tagged);\n    // The two hull edges whose endpoints belong to different shapes are the bridges.\n    const bridges = [];\n    for (let i = 0; i < H.length; i++) {\n        const u = H[i];\n        const w = H[(i + 1) % H.length];\n        if (u.tag !== w.tag) {\n            bridges.push({\n                aIdx: u.tag === 0 ? u.idx : w.idx,\n                bIdx: u.tag === 1 ? u.idx : w.idx,\n            });\n        }\n    }\n    const straightFuse = () => new Assembly({\n        geometry: shapeA.geometry.fuse(shapeB.geometry),\n        color,\n        tags: [\"shrink-wrap\", \"tangent-arc\"],\n    });\n    // Not two clean bridges (e.g. one shape inside the other, or overlapping) -\n    // fall back to a plain fuse.\n    if (bridges.length !== 2)\n        return straightFuse();\n    // Nearest points between the two outlines (the narrowest part of the gap).\n    let bestD = Infinity;\n    let naIdx = 0;\n    let nbIdx = 0;\n    for (let i = 0; i < A.length; i++) {\n        for (let j = 0; j < B.length; j++) {\n            const d = dot(sub(A[i], B[j]), sub(A[i], B[j]));\n            if (d < bestD) {\n                bestD = d;\n                naIdx = i;\n                nbIdx = j;\n            }\n        }\n    }\n    bestD = Math.sqrt(bestD);\n    if (bestD < 1e-4)\n        return straightFuse(); // touching / overlapping\n    // Slide each bridge's contacts toward the nearest point by bowDepth.\n    const b0 = bridges[0];\n    const b1 = bridges[1];\n    const ca0 = slide(A, b0.aIdx, naIdx, bowDepth);\n    const cb0 = slide(B, b0.bIdx, nbIdx, bowDepth);\n    const ca1 = slide(A, b1.aIdx, naIdx, bowDepth);\n    const cb1 = slide(B, b1.bIdx, nbIdx, bowDepth);\n    // Forward tangents (direction of travel along the perimeter).\n    const f0 = sub(cb0.pt, ca0.pt);\n    const tCa0 = orient(ca0.tan, f0);\n    const tCb0 = orient(cb0.tan, f0);\n    const f1 = sub(ca1.pt, cb1.pt);\n    const tCb1 = orient(cb1.tan, f1);\n    const tCa1 = orient(ca1.tan, f1);\n    // Trace the full merged perimeter as a single closed sketch (no boolean, so\n    // the biarcs stay exactly tangent to each shape at the contacts):\n    //   A-contact0 --biarc--> B-contact0 --B outer arc--> B-contact1\n    //     --biarc--> A-contact1 --A outer arc--> back to A-contact0\n    const pen = replicad.draw([ca0.pt.x, ca0.pt.y]);\n    drawBiarc(pen, ca0.pt, tCa0, cb0.pt, tCb0);\n    for (const v of arcVerts(B, cb0.f, cb1.f, nbIdx))\n        pen.lineTo([v.x, v.y]);\n    pen.lineTo([cb1.pt.x, cb1.pt.y]);\n    drawBiarc(pen, cb1.pt, tCb1, ca1.pt, tCa1);\n    for (const v of arcVerts(A, ca1.f, ca0.f, naIdx))\n        pen.lineTo([v.x, v.y]);\n    const merged = pen.close();\n    return new Assembly({\n        geometry: merged,\n        color,\n        tags: [\"shrink-wrap\", \"tangent-arc\"],\n        bom: [...(shapeA.bom || []), ...(shapeB.bom || [])],\n    });\n}\n"
            },
            {
              "atomType": "Code",
              "x": 0.35383597883597884,
              "y": 0.5153203342618384,
              "uniqueID": "id-5284",
              "ioValues": [
                {
                  "name": "shapeA",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "shapeB",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "bowDepth",
                  "ioValue": 0.6
                },
                {
                  "name": "color",
                  "ioValue": "#5B9BD5",
                  "currentEquation": "#5B9BD5"
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Tangent-Arc Shrink Wrap\n * =======================\n *\n * Like the built-in \"Shrink Wrap\" atom, this joins two 2D shapes into a single\n * sketch by filling the gap between them. The difference is HOW the gap is\n * bridged: instead of two straight tangent lines, the two shapes are connected\n * with concave biarcs (pairs of circular arcs) that are **tangent to each shape\n * at the point of contact** and bow *into* the gap, so the connection only lives\n * in the empty space between the shapes and never cuts into either one.\n *\n * The two arcs of each biarc guarantee exact tangency at both shape contacts.\n * `bowDepth` (0..1) sets how deeply the connection pinches into the gap: 0 gives\n * an almost straight shrink-wrap bridge, 1 gives the deepest safe waist. It is a\n * normalized amount (not millimetres) so it behaves the same whatever the size\n * of the shapes, and it saturates rather than breaking down at the top end.\n *\n * Inputs:\n *   shapeA, shapeB - the two 2D sketches to connect (order does not matter)\n *   bowDepth       - waist depth, 0 (straight) .. 1 (deepest pinch)\n *   color          - display colour of the resulting sketch\n */\nfunction run(\n  shapeA: Assembly | undefined = undefined,\n  shapeB: Assembly | undefined = undefined,\n  bowDepth: number = 0.5,\n  color: string = \"#5B9BD5\",\n): Assembly {\n  if (!shapeA || !shapeB) {\n    throw new Error(\n      \"Tangent-Arc Shrink Wrap needs two 2D shapes connected to its inputs.\",\n    );\n  }\n\n  // ---------------------------------------------------------------------------\n  // Minimal 2D vector helpers (operate on { x, y } points)\n  // ---------------------------------------------------------------------------\n  type P = { x: number; y: number };\n  const sub = (a: P, b: P): P => ({ x: a.x - b.x, y: a.y - b.y });\n  const add = (a: P, b: P): P => ({ x: a.x + b.x, y: a.y + b.y });\n  const scale = (a: P, s: number): P => ({ x: a.x * s, y: a.y * s });\n  const dot = (a: P, b: P): number => a.x * b.x + a.y * b.y;\n  const cross = (a: P, b: P): number => a.x * b.y - a.y * b.x;\n  const len = (a: P): number => Math.hypot(a.x, a.y);\n  const norm = (a: P): P => {\n    const l = len(a) || 1;\n    return { x: a.x / l, y: a.y / l };\n  };\n  const leftPerp = (a: P): P => ({ x: -a.y, y: a.x });\n  // Orient v so it points in the same half-plane as reference vector ref.\n  const orient = (v: P, ref: P): P => (dot(v, ref) >= 0 ? v : scale(v, -1));\n\n  // ---------------------------------------------------------------------------\n  // Turn a 2D input Assembly into an ordered, counter-clockwise outline polygon.\n  // ---------------------------------------------------------------------------\n  function orderEdges(mesh: any): P[] {\n    // meshEdges returns { lines:[x,y,z,...], edgeGroups:[{start,count,edgeId}] }.\n    // The edge groups are not guaranteed to be in winding order, so stitch them\n    // together end-to-end (same approach as the worker's preparePoints()).\n    const tol = 1e-4;\n    const almostEqual = (p: P, q: P) =>\n      Math.abs(p.x - q.x) < tol && Math.abs(p.y - q.y) < tol;\n    type EStart = { startPoint: P; start: number; steps: number; edgeId: number };\n    let edgeStarts: EStart[] = [];\n    mesh.edgeGroups.forEach((edge: any) => {\n      edgeStarts.push({\n        startPoint: {\n          x: mesh.lines[edge.start * 3],\n          y: mesh.lines[edge.start * 3 + 1],\n        },\n        start: edge.start * 3,\n        steps: edge.count,\n        edgeId: edge.edgeId,\n      });\n      const endIndex = (edge.start + edge.count - 1) * 3;\n      edgeStarts.push({\n        startPoint: { x: mesh.lines[endIndex], y: mesh.lines[endIndex + 1] },\n        start: endIndex,\n        steps: -edge.count,\n        edgeId: edge.edgeId,\n      });\n    });\n\n    const result: P[] = [];\n    if (edgeStarts.length === 0) return result;\n    let currentEdge = edgeStarts[0];\n    let guard = 0;\n    while (edgeStarts.length > 0 && guard++ < 100000) {\n      for (let i = 1; i < Math.abs(currentEdge.steps); i++) {\n        let offset = i * 3;\n        if (currentEdge.steps < 0) offset = -offset;\n        const index = currentEdge.start + offset;\n        const nextPoint = { x: mesh.lines[index], y: mesh.lines[index + 1] };\n        if (\n          result.length === 0 ||\n          !almostEqual(result[result.length - 1], nextPoint)\n        ) {\n          result.push(nextPoint);\n        }\n      }\n      const curId = currentEdge.edgeId;\n      edgeStarts = edgeStarts.filter((e) => e.edgeId !== curId);\n      if (edgeStarts.length === 0) break;\n      const last = result[result.length - 1];\n      const nextEdges = edgeStarts.filter((e) => almostEqual(last, e.startPoint));\n      if (nextEdges.length === 0) break;\n      currentEdge = nextEdges[0];\n    }\n    return result;\n  }\n\n  function outline(asm: Assembly): P[] {\n    const drawing: any = asm.geometry;\n    if (!drawing || typeof drawing.sketchOnPlane !== \"function\") {\n      throw new Error(\n        \"Tangent-Arc Shrink Wrap inputs must be 2D sketches (not 3D solids or wires).\",\n      );\n    }\n    const sketched: any = drawing.sketchOnPlane();\n    if (typeof sketched.face !== \"function\") {\n      throw new Error(\n        \"Tangent-Arc Shrink Wrap needs simple single-region 2D shapes.\",\n      );\n    }\n    const face = sketched.face();\n    const mesh = face\n      .clone()\n      .outerWire()\n      .meshEdges({ tolerance: 0.05, angularTolerance: 0.05 });\n    const pts = orderEdges(mesh);\n    if (pts.length < 3) {\n      throw new Error(\"Could not read the outline of a Tangent-Arc Shrink Wrap input.\");\n    }\n    // Ensure counter-clockwise winding (positive signed area).\n    let area = 0;\n    for (let i = 0; i < pts.length; i++) {\n      area += cross(pts[i], pts[(i + 1) % pts.length]);\n    }\n    if (area < 0) pts.reverse();\n    // Densify: a flat edge (e.g. a square side) is meshed as just its two\n    // corner vertices, so the nearest-vertex search would land on a corner\n    // instead of the true nearest point on the edge, making the contact edge\n    // selection unstable. Subdividing long edges gives interior points so the\n    // nearest point and slide/trace logic are well defined.\n    let perim = 0;\n    for (let i = 0; i < pts.length; i++) {\n      perim += len(sub(pts[(i + 1) % pts.length], pts[i]));\n    }\n    return densify(pts, Math.max(perim / 256, 1e-6));\n  }\n\n  // Insert interior points on any edge longer than maxSeg (keeps winding order).\n  function densify(poly: P[], maxSeg: number): P[] {\n    const out: P[] = [];\n    const n = poly.length;\n    for (let i = 0; i < n; i++) {\n      const a = poly[i];\n      const b = poly[(i + 1) % n];\n      out.push(a);\n      const d = sub(b, a);\n      const k = Math.floor(len(d) / maxSeg);\n      for (let j = 1; j <= k; j++) {\n        out.push(add(a, scale(d, j / (k + 1))));\n      }\n    }\n    return out;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Convex hull (monotone chain) over the combined, source-tagged point set.\n  // The two hull edges that jump between shapes are the two \"bridges\" that a\n  // straight shrink wrap would draw, and their endpoints are the tangent\n  // contact points on each shape.\n  // ---------------------------------------------------------------------------\n  type TP = { p: P; tag: number; idx: number };\n  function hull(points: TP[]): TP[] {\n    const pts = points\n      .slice()\n      .sort((a, b) => a.p.x - b.p.x || a.p.y - b.p.y);\n    const o = (a: P, b: P, c: P) =>\n      (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);\n    const lower: TP[] = [];\n    for (const pt of pts) {\n      while (\n        lower.length >= 2 &&\n        o(lower[lower.length - 2].p, lower[lower.length - 1].p, pt.p) <= 0\n      )\n        lower.pop();\n      lower.push(pt);\n    }\n    const upper: TP[] = [];\n    for (let i = pts.length - 1; i >= 0; i--) {\n      const pt = pts[i];\n      while (\n        upper.length >= 2 &&\n        o(upper[upper.length - 2].p, upper[upper.length - 1].p, pt.p) <= 0\n      )\n        upper.pop();\n      upper.push(pt);\n    }\n    lower.pop();\n    upper.pop();\n    return lower.concat(upper);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Slide a contact point along an outline, from the straight-tangent contact\n  // toward the nearest point. `amount` is a 0..1 fraction of the safe slide\n  // distance; the safe cap keeps the contact in the region where sliding\n  // further always deepens (never reverses) the waist. Returns the slid point,\n  // the outline tangent there (pointing into the gap), and the fractional vertex\n  // index `f` of the slid point (used later to splice the outline).\n  // ---------------------------------------------------------------------------\n  const SAFE_SLIDE = 0.6; // fraction of the arc-to-nearest that stays monotonic\n  function slide(\n    poly: P[],\n    startIdx: number,\n    targetIdx: number,\n    amount: number,\n  ): { pt: P; tan: P; f: number } {\n    const n = poly.length;\n    const pathLen = (dir: number) => {\n      let d = 0;\n      let i = startIdx;\n      let g = 0;\n      while (i !== targetIdx && g++ < n) {\n        const j = (i + dir + n) % n;\n        d += len(sub(poly[j], poly[i]));\n        i = j;\n      }\n      return d;\n    };\n    const dFwd = pathLen(1);\n    const dBwd = pathLen(-1);\n    const dir = dFwd <= dBwd ? 1 : -1;\n    const frac = Math.max(0, Math.min(1, amount));\n    let remaining = frac * SAFE_SLIDE * Math.min(dFwd, dBwd);\n\n    if (remaining < 1e-9) {\n      const nextP = poly[(startIdx + dir + n) % n];\n      return {\n        pt: poly[startIdx],\n        tan: norm(sub(nextP, poly[startIdx])),\n        f: startIdx,\n      };\n    }\n    let i = startIdx;\n    let guard = 0;\n    while (guard++ < n) {\n      const j = (i + dir + n) % n;\n      const seg = sub(poly[j], poly[i]);\n      const segLen = len(seg);\n      if (segLen >= remaining) {\n        const t = remaining / (segLen || 1);\n        return {\n          pt: add(poly[i], scale(seg, t)),\n          tan: norm(seg),\n          f: ((i + dir * t) % n + n) % n,\n        };\n      }\n      remaining -= segLen;\n      i = j;\n    }\n    const nextP = poly[(i + dir + n) % n];\n    return { pt: poly[i], tan: norm(sub(nextP, poly[i])), f: i };\n  }\n\n  // ---------------------------------------------------------------------------\n  // Integer outline vertices strictly between fractional indices fStart and\n  // fEnd, walking whichever way around the polygon does NOT pass avoidIdx (i.e.\n  // the outer side, away from the gap).\n  // ---------------------------------------------------------------------------\n  function arcVerts(\n    poly: P[],\n    fStart: number,\n    fEnd: number,\n    avoidIdx: number,\n  ): P[] {\n    const n = poly.length;\n    const modn = (x: number) => ((x % n) + n) % n;\n    const spanFwd = modn(fEnd - fStart);\n    const relAvoid = modn(avoidIdx - fStart);\n    const fwdHasAvoid = relAvoid > 1e-9 && relAvoid < spanFwd - 1e-9;\n    const res: P[] = [];\n    if (!fwdHasAvoid) {\n      let k = Math.ceil(fStart + 1e-9);\n      let guard = 0;\n      while (modn(k - fStart) < spanFwd - 1e-9 && guard++ <= n) {\n        res.push(poly[modn(k)]);\n        k++;\n      }\n    } else {\n      const spanBwd = modn(fStart - fEnd);\n      let k = Math.floor(fStart - 1e-9);\n      let guard = 0;\n      while (modn(fStart - k) < spanBwd - 1e-9 && guard++ <= n) {\n        res.push(poly[modn(k)]);\n        k--;\n      }\n    }\n    return res;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Midpoint of the circular arc that starts at A with unit tangent t and ends\n  // at Bp. Returns null when the arc is (near) straight -> caller uses a line.\n  // ---------------------------------------------------------------------------\n  function arcMidpoint(A: P, Bp: P, t: P): P | null {\n    const n = leftPerp(t);\n    const ab = sub(A, Bp);\n    const denom = dot(n, ab);\n    if (Math.abs(denom) < 1e-7) return null; // straight\n    const r = -dot(ab, ab) / (2 * denom); // signed radius along n\n    const C = add(A, scale(n, r));\n    const R = Math.abs(r);\n    if (!(R > 1e-9) || !isFinite(R)) return null;\n    const a0 = Math.atan2(A.y - C.y, A.x - C.x);\n    const a1 = Math.atan2(Bp.y - C.y, Bp.x - C.x);\n    // Tangent at A for counter-clockwise motion:\n    const ccwTan = leftPerp(sub(A, C));\n    const goesCCW = dot(ccwTan, t) > 0;\n    let dA = a1 - a0;\n    if (goesCCW) {\n      while (dA <= 0) dA += 2 * Math.PI;\n    } else {\n      while (dA >= 0) dA -= 2 * Math.PI;\n    }\n    const aMid = a0 + dA / 2;\n    return { x: C.x + R * Math.cos(aMid), y: C.y + R * Math.sin(aMid) };\n  }\n\n  // ---------------------------------------------------------------------------\n  // Equal-tangent-length biarc join point. Given the two endpoints and their\n  // forward unit tangents, this closed form returns the join point J of the two\n  // circular arcs that meet with G1 (tangent) continuity. Returns null when the\n  // arc degenerates to a straight line.\n  // ---------------------------------------------------------------------------\n  function biarcJoin(P0: P, t0: P, P1: P, t1: P): P | null {\n    const v = sub(P1, P0);\n    const t = add(t0, t1);\n    const vt = dot(v, t);\n    const denom = 2 * (1 - dot(t0, t1));\n    let d: number;\n    if (Math.abs(denom) < 1e-9) {\n      // Parallel tangents: only a straight line unless there is a lateral offset.\n      if (Math.abs(vt) < 1e-9) return null;\n      d = dot(v, v) / (4 * vt);\n    } else {\n      const disc = vt * vt + denom * dot(v, v);\n      if (disc < 0) return null;\n      d = (-vt + Math.sqrt(disc)) / denom;\n    }\n    if (!isFinite(d) || d <= 1e-9) return null;\n    return add(scale(add(P0, P1), 0.5), scale(sub(t0, t1), d * 0.5));\n  }\n\n  // ---------------------------------------------------------------------------\n  // Draw one biarc from the pen's current position (P0) to P1, tangent to t0 at\n  // P0 and to t1 at P1. Each arc is drawn as the circle tangent to its shape's\n  // outline, so tangency at both shape contacts is exact.\n  // ---------------------------------------------------------------------------\n  function drawBiarc(pen: any, P0: P, t0: P, P1: P, t1: P): void {\n    const J = biarcJoin(P0, t0, P1, t1);\n    if (!J) {\n      pen.lineTo([P1.x, P1.y]);\n      return;\n    }\n    const mid1 = arcMidpoint(P0, J, t0);\n    if (mid1) pen.threePointsArcTo([J.x, J.y], [mid1.x, mid1.y]);\n    else pen.lineTo([J.x, J.y]);\n\n    // Arc 2 is the circle tangent to t1 at P1 (through J) -> exact tangency to B.\n    // t1 is the forward (arriving) tangent, so travelling P1 -> J the departure\n    // tangent is -t1; using it keeps arc 2 the minor (gap-side) arc.\n    const mid2 = arcMidpoint(P1, J, scale(t1, -1));\n    if (mid2) pen.threePointsArcTo([P1.x, P1.y], [mid2.x, mid2.y]);\n    else pen.lineTo([P1.x, P1.y]);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Main\n  // ---------------------------------------------------------------------------\n  const A = outline(shapeA);\n  const B = outline(shapeB);\n\n  const tagged: TP[] = [\n    ...A.map((p, i) => ({ p, tag: 0, idx: i })),\n    ...B.map((p, i) => ({ p, tag: 1, idx: i })),\n  ];\n  const H = hull(tagged);\n\n  // The two hull edges whose endpoints belong to different shapes are the bridges.\n  const bridges: { aIdx: number; bIdx: number }[] = [];\n  for (let i = 0; i < H.length; i++) {\n    const u = H[i];\n    const w = H[(i + 1) % H.length];\n    if (u.tag !== w.tag) {\n      bridges.push({\n        aIdx: u.tag === 0 ? u.idx : w.idx,\n        bIdx: u.tag === 1 ? u.idx : w.idx,\n      });\n    }\n  }\n\n  const straightFuse = () =>\n    new Assembly({\n      geometry: (shapeA!.geometry as any).fuse(shapeB!.geometry),\n      color,\n      tags: [\"shrink-wrap\", \"tangent-arc\"],\n    });\n\n  // Not two clean bridges (e.g. one shape inside the other, or overlapping) -\n  // fall back to a plain fuse.\n  if (bridges.length !== 2) return straightFuse();\n\n  // Nearest points between the two outlines (the narrowest part of the gap).\n  let bestD = Infinity;\n  let naIdx = 0;\n  let nbIdx = 0;\n  for (let i = 0; i < A.length; i++) {\n    for (let j = 0; j < B.length; j++) {\n      const d = dot(sub(A[i], B[j]), sub(A[i], B[j]));\n      if (d < bestD) {\n        bestD = d;\n        naIdx = i;\n        nbIdx = j;\n      }\n    }\n  }\n  bestD = Math.sqrt(bestD);\n  if (bestD < 1e-4) return straightFuse(); // touching / overlapping\n\n  // Slide each bridge's contacts toward the nearest point by bowDepth.\n  const b0 = bridges[0];\n  const b1 = bridges[1];\n  const ca0 = slide(A, b0.aIdx, naIdx, bowDepth);\n  const cb0 = slide(B, b0.bIdx, nbIdx, bowDepth);\n  const ca1 = slide(A, b1.aIdx, naIdx, bowDepth);\n  const cb1 = slide(B, b1.bIdx, nbIdx, bowDepth);\n\n  // Outer-side outline vertices for each shape (the far side, away from the gap).\n  const bVerts = arcVerts(B, cb0.f, cb1.f, nbIdx);\n  const aVerts = arcVerts(A, ca1.f, ca0.f, naIdx);\n\n  // Neighbouring traced points around each contact, used to orient the biarc\n  // end tangents. Orienting by the adjacent trace direction (rather than the\n  // chord between contacts) keeps the correct tangent sign even when a shape's\n  // facing edge is flat and perpendicular to the gap (e.g. a square), which\n  // otherwise produces a 90-degree cusp at the contact.\n  const prevA = aVerts.length ? aVerts[aVerts.length - 1] : ca1.pt;\n  const nextA = aVerts.length ? aVerts[0] : ca0.pt;\n  const prevB = bVerts.length ? bVerts[bVerts.length - 1] : cb0.pt;\n  const nextB = bVerts.length ? bVerts[0] : cb1.pt;\n\n  const tCa0 = orient(ca0.tan, sub(ca0.pt, prevA));\n  const tCb0 = orient(cb0.tan, sub(nextB, cb0.pt));\n  const tCb1 = orient(cb1.tan, sub(cb1.pt, prevB));\n  const tCa1 = orient(ca1.tan, sub(nextA, ca1.pt));\n\n  // Trace the full merged perimeter as a single closed sketch (no boolean, so\n  // the biarcs stay exactly tangent to each shape at the contacts):\n  //   A-contact0 --biarc--> B-contact0 --B outer arc--> B-contact1\n  //     --biarc--> A-contact1 --A outer arc--> back to A-contact0\n  const pen = replicad.draw([ca0.pt.x, ca0.pt.y]);\n  drawBiarc(pen, ca0.pt, tCa0, cb0.pt, tCb0);\n  for (const v of bVerts) pen.lineTo([v.x, v.y]);\n  pen.lineTo([cb1.pt.x, cb1.pt.y]);\n  drawBiarc(pen, cb1.pt, tCb1, ca1.pt, tCa1);\n  for (const v of aVerts) pen.lineTo([v.x, v.y]);\n  const merged = pen.close();\n\n  return new Assembly({\n    geometry: merged,\n    color,\n    tags: [\"shrink-wrap\", \"tangent-arc\"],\n    bom: [...(shapeA.bom || []), ...(shapeB.bom || [])],\n  });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Tangent-Arc Shrink Wrap\n * =======================\n *\n * Like the built-in \"Shrink Wrap\" atom, this joins two 2D shapes into a single\n * sketch by filling the gap between them. The difference is HOW the gap is\n * bridged: instead of two straight tangent lines, the two shapes are connected\n * with concave biarcs (pairs of circular arcs) that are **tangent to each shape\n * at the point of contact** and bow *into* the gap, so the connection only lives\n * in the empty space between the shapes and never cuts into either one.\n *\n * The two arcs of each biarc guarantee exact tangency at both shape contacts.\n * `bowDepth` (0..1) sets how deeply the connection pinches into the gap: 0 gives\n * an almost straight shrink-wrap bridge, 1 gives the deepest safe waist. It is a\n * normalized amount (not millimetres) so it behaves the same whatever the size\n * of the shapes, and it saturates rather than breaking down at the top end.\n *\n * Inputs:\n *   shapeA, shapeB - the two 2D sketches to connect (order does not matter)\n *   bowDepth       - waist depth, 0 (straight) .. 1 (deepest pinch)\n *   color          - display colour of the resulting sketch\n */\nfunction run(shapeA = undefined, shapeB = undefined, bowDepth = 0.5, color = \"#5B9BD5\") {\n    if (!shapeA || !shapeB) {\n        throw new Error(\"Tangent-Arc Shrink Wrap needs two 2D shapes connected to its inputs.\");\n    }\n    const sub = (a, b) => ({ x: a.x - b.x, y: a.y - b.y });\n    const add = (a, b) => ({ x: a.x + b.x, y: a.y + b.y });\n    const scale = (a, s) => ({ x: a.x * s, y: a.y * s });\n    const dot = (a, b) => a.x * b.x + a.y * b.y;\n    const cross = (a, b) => a.x * b.y - a.y * b.x;\n    const len = (a) => Math.hypot(a.x, a.y);\n    const norm = (a) => {\n        const l = len(a) || 1;\n        return { x: a.x / l, y: a.y / l };\n    };\n    const leftPerp = (a) => ({ x: -a.y, y: a.x });\n    // Orient v so it points in the same half-plane as reference vector ref.\n    const orient = (v, ref) => (dot(v, ref) >= 0 ? v : scale(v, -1));\n    // ---------------------------------------------------------------------------\n    // Turn a 2D input Assembly into an ordered, counter-clockwise outline polygon.\n    // ---------------------------------------------------------------------------\n    function orderEdges(mesh) {\n        // meshEdges returns { lines:[x,y,z,...], edgeGroups:[{start,count,edgeId}] }.\n        // The edge groups are not guaranteed to be in winding order, so stitch them\n        // together end-to-end (same approach as the worker's preparePoints()).\n        const tol = 1e-4;\n        const almostEqual = (p, q) => Math.abs(p.x - q.x) < tol && Math.abs(p.y - q.y) < tol;\n        let edgeStarts = [];\n        mesh.edgeGroups.forEach((edge) => {\n            edgeStarts.push({\n                startPoint: {\n                    x: mesh.lines[edge.start * 3],\n                    y: mesh.lines[edge.start * 3 + 1],\n                },\n                start: edge.start * 3,\n                steps: edge.count,\n                edgeId: edge.edgeId,\n            });\n            const endIndex = (edge.start + edge.count - 1) * 3;\n            edgeStarts.push({\n                startPoint: { x: mesh.lines[endIndex], y: mesh.lines[endIndex + 1] },\n                start: endIndex,\n                steps: -edge.count,\n                edgeId: edge.edgeId,\n            });\n        });\n        const result = [];\n        if (edgeStarts.length === 0)\n            return result;\n        let currentEdge = edgeStarts[0];\n        let guard = 0;\n        while (edgeStarts.length > 0 && guard++ < 100000) {\n            for (let i = 1; i < Math.abs(currentEdge.steps); i++) {\n                let offset = i * 3;\n                if (currentEdge.steps < 0)\n                    offset = -offset;\n                const index = currentEdge.start + offset;\n                const nextPoint = { x: mesh.lines[index], y: mesh.lines[index + 1] };\n                if (result.length === 0 ||\n                    !almostEqual(result[result.length - 1], nextPoint)) {\n                    result.push(nextPoint);\n                }\n            }\n            const curId = currentEdge.edgeId;\n            edgeStarts = edgeStarts.filter((e) => e.edgeId !== curId);\n            if (edgeStarts.length === 0)\n                break;\n            const last = result[result.length - 1];\n            const nextEdges = edgeStarts.filter((e) => almostEqual(last, e.startPoint));\n            if (nextEdges.length === 0)\n                break;\n            currentEdge = nextEdges[0];\n        }\n        return result;\n    }\n    function outline(asm) {\n        const drawing = asm.geometry;\n        if (!drawing || typeof drawing.sketchOnPlane !== \"function\") {\n            throw new Error(\"Tangent-Arc Shrink Wrap inputs must be 2D sketches (not 3D solids or wires).\");\n        }\n        const sketched = drawing.sketchOnPlane();\n        if (typeof sketched.face !== \"function\") {\n            throw new Error(\"Tangent-Arc Shrink Wrap needs simple single-region 2D shapes.\");\n        }\n        const face = sketched.face();\n        const mesh = face\n            .clone()\n            .outerWire()\n            .meshEdges({ tolerance: 0.05, angularTolerance: 0.05 });\n        const pts = orderEdges(mesh);\n        if (pts.length < 3) {\n            throw new Error(\"Could not read the outline of a Tangent-Arc Shrink Wrap input.\");\n        }\n        // Ensure counter-clockwise winding (positive signed area).\n        let area = 0;\n        for (let i = 0; i < pts.length; i++) {\n            area += cross(pts[i], pts[(i + 1) % pts.length]);\n        }\n        if (area < 0)\n            pts.reverse();\n        // Densify: a flat edge (e.g. a square side) is meshed as just its two\n        // corner vertices, so the nearest-vertex search would land on a corner\n        // instead of the true nearest point on the edge, making the contact edge\n        // selection unstable. Subdividing long edges gives interior points so the\n        // nearest point and slide/trace logic are well defined.\n        let perim = 0;\n        for (let i = 0; i < pts.length; i++) {\n            perim += len(sub(pts[(i + 1) % pts.length], pts[i]));\n        }\n        return densify(pts, Math.max(perim / 256, 1e-6));\n    }\n    // Insert interior points on any edge longer than maxSeg (keeps winding order).\n    function densify(poly, maxSeg) {\n        const out = [];\n        const n = poly.length;\n        for (let i = 0; i < n; i++) {\n            const a = poly[i];\n            const b = poly[(i + 1) % n];\n            out.push(a);\n            const d = sub(b, a);\n            const k = Math.floor(len(d) / maxSeg);\n            for (let j = 1; j <= k; j++) {\n                out.push(add(a, scale(d, j / (k + 1))));\n            }\n        }\n        return out;\n    }\n    function hull(points) {\n        const pts = points\n            .slice()\n            .sort((a, b) => a.p.x - b.p.x || a.p.y - b.p.y);\n        const o = (a, b, c) => (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);\n        const lower = [];\n        for (const pt of pts) {\n            while (lower.length >= 2 &&\n                o(lower[lower.length - 2].p, lower[lower.length - 1].p, pt.p) <= 0)\n                lower.pop();\n            lower.push(pt);\n        }\n        const upper = [];\n        for (let i = pts.length - 1; i >= 0; i--) {\n            const pt = pts[i];\n            while (upper.length >= 2 &&\n                o(upper[upper.length - 2].p, upper[upper.length - 1].p, pt.p) <= 0)\n                upper.pop();\n            upper.push(pt);\n        }\n        lower.pop();\n        upper.pop();\n        return lower.concat(upper);\n    }\n    // ---------------------------------------------------------------------------\n    // Slide a contact point along an outline, from the straight-tangent contact\n    // toward the nearest point. `amount` is a 0..1 fraction of the safe slide\n    // distance; the safe cap keeps the contact in the region where sliding\n    // further always deepens (never reverses) the waist. Returns the slid point,\n    // the outline tangent there (pointing into the gap), and the fractional vertex\n    // index `f` of the slid point (used later to splice the outline).\n    // ---------------------------------------------------------------------------\n    const SAFE_SLIDE = 0.6; // fraction of the arc-to-nearest that stays monotonic\n    function slide(poly, startIdx, targetIdx, amount) {\n        const n = poly.length;\n        const pathLen = (dir) => {\n            let d = 0;\n            let i = startIdx;\n            let g = 0;\n            while (i !== targetIdx && g++ < n) {\n                const j = (i + dir + n) % n;\n                d += len(sub(poly[j], poly[i]));\n                i = j;\n            }\n            return d;\n        };\n        const dFwd = pathLen(1);\n        const dBwd = pathLen(-1);\n        const dir = dFwd <= dBwd ? 1 : -1;\n        const frac = Math.max(0, Math.min(1, amount));\n        let remaining = frac * SAFE_SLIDE * Math.min(dFwd, dBwd);\n        if (remaining < 1e-9) {\n            const nextP = poly[(startIdx + dir + n) % n];\n            return {\n                pt: poly[startIdx],\n                tan: norm(sub(nextP, poly[startIdx])),\n                f: startIdx,\n            };\n        }\n        let i = startIdx;\n        let guard = 0;\n        while (guard++ < n) {\n            const j = (i + dir + n) % n;\n            const seg = sub(poly[j], poly[i]);\n            const segLen = len(seg);\n            if (segLen >= remaining) {\n                const t = remaining / (segLen || 1);\n                return {\n                    pt: add(poly[i], scale(seg, t)),\n                    tan: norm(seg),\n                    f: ((i + dir * t) % n + n) % n,\n                };\n            }\n            remaining -= segLen;\n            i = j;\n        }\n        const nextP = poly[(i + dir + n) % n];\n        return { pt: poly[i], tan: norm(sub(nextP, poly[i])), f: i };\n    }\n    // ---------------------------------------------------------------------------\n    // Integer outline vertices strictly between fractional indices fStart and\n    // fEnd, walking whichever way around the polygon does NOT pass avoidIdx (i.e.\n    // the outer side, away from the gap).\n    // ---------------------------------------------------------------------------\n    function arcVerts(poly, fStart, fEnd, avoidIdx) {\n        const n = poly.length;\n        const modn = (x) => ((x % n) + n) % n;\n        const spanFwd = modn(fEnd - fStart);\n        const relAvoid = modn(avoidIdx - fStart);\n        const fwdHasAvoid = relAvoid > 1e-9 && relAvoid < spanFwd - 1e-9;\n        const res = [];\n        if (!fwdHasAvoid) {\n            let k = Math.ceil(fStart + 1e-9);\n            let guard = 0;\n            while (modn(k - fStart) < spanFwd - 1e-9 && guard++ <= n) {\n                res.push(poly[modn(k)]);\n                k++;\n            }\n        }\n        else {\n            const spanBwd = modn(fStart - fEnd);\n            let k = Math.floor(fStart - 1e-9);\n            let guard = 0;\n            while (modn(fStart - k) < spanBwd - 1e-9 && guard++ <= n) {\n                res.push(poly[modn(k)]);\n                k--;\n            }\n        }\n        return res;\n    }\n    // ---------------------------------------------------------------------------\n    // Midpoint of the circular arc that starts at A with unit tangent t and ends\n    // at Bp. Returns null when the arc is (near) straight -> caller uses a line.\n    // ---------------------------------------------------------------------------\n    function arcMidpoint(A, Bp, t) {\n        const n = leftPerp(t);\n        const ab = sub(A, Bp);\n        const denom = dot(n, ab);\n        if (Math.abs(denom) < 1e-7)\n            return null; // straight\n        const r = -dot(ab, ab) / (2 * denom); // signed radius along n\n        const C = add(A, scale(n, r));\n        const R = Math.abs(r);\n        if (!(R > 1e-9) || !isFinite(R))\n            return null;\n        const a0 = Math.atan2(A.y - C.y, A.x - C.x);\n        const a1 = Math.atan2(Bp.y - C.y, Bp.x - C.x);\n        // Tangent at A for counter-clockwise motion:\n        const ccwTan = leftPerp(sub(A, C));\n        const goesCCW = dot(ccwTan, t) > 0;\n        let dA = a1 - a0;\n        if (goesCCW) {\n            while (dA <= 0)\n                dA += 2 * Math.PI;\n        }\n        else {\n            while (dA >= 0)\n                dA -= 2 * Math.PI;\n        }\n        const aMid = a0 + dA / 2;\n        return { x: C.x + R * Math.cos(aMid), y: C.y + R * Math.sin(aMid) };\n    }\n    // ---------------------------------------------------------------------------\n    // Equal-tangent-length biarc join point. Given the two endpoints and their\n    // forward unit tangents, this closed form returns the join point J of the two\n    // circular arcs that meet with G1 (tangent) continuity. Returns null when the\n    // arc degenerates to a straight line.\n    // ---------------------------------------------------------------------------\n    function biarcJoin(P0, t0, P1, t1) {\n        const v = sub(P1, P0);\n        const t = add(t0, t1);\n        const vt = dot(v, t);\n        const denom = 2 * (1 - dot(t0, t1));\n        let d;\n        if (Math.abs(denom) < 1e-9) {\n            // Parallel tangents: only a straight line unless there is a lateral offset.\n            if (Math.abs(vt) < 1e-9)\n                return null;\n            d = dot(v, v) / (4 * vt);\n        }\n        else {\n            const disc = vt * vt + denom * dot(v, v);\n            if (disc < 0)\n                return null;\n            d = (-vt + Math.sqrt(disc)) / denom;\n        }\n        if (!isFinite(d) || d <= 1e-9)\n            return null;\n        return add(scale(add(P0, P1), 0.5), scale(sub(t0, t1), d * 0.5));\n    }\n    // ---------------------------------------------------------------------------\n    // Draw one biarc from the pen's current position (P0) to P1, tangent to t0 at\n    // P0 and to t1 at P1. Each arc is drawn as the circle tangent to its shape's\n    // outline, so tangency at both shape contacts is exact.\n    // ---------------------------------------------------------------------------\n    function drawBiarc(pen, P0, t0, P1, t1) {\n        const J = biarcJoin(P0, t0, P1, t1);\n        if (!J) {\n            pen.lineTo([P1.x, P1.y]);\n            return;\n        }\n        const mid1 = arcMidpoint(P0, J, t0);\n        if (mid1)\n            pen.threePointsArcTo([J.x, J.y], [mid1.x, mid1.y]);\n        else\n            pen.lineTo([J.x, J.y]);\n        // Arc 2 is the circle tangent to t1 at P1 (through J) -> exact tangency to B.\n        // t1 is the forward (arriving) tangent, so travelling P1 -> J the departure\n        // tangent is -t1; using it keeps arc 2 the minor (gap-side) arc.\n        const mid2 = arcMidpoint(P1, J, scale(t1, -1));\n        if (mid2)\n            pen.threePointsArcTo([P1.x, P1.y], [mid2.x, mid2.y]);\n        else\n            pen.lineTo([P1.x, P1.y]);\n    }\n    // ---------------------------------------------------------------------------\n    // Main\n    // ---------------------------------------------------------------------------\n    const A = outline(shapeA);\n    const B = outline(shapeB);\n    const tagged = [\n        ...A.map((p, i) => ({ p, tag: 0, idx: i })),\n        ...B.map((p, i) => ({ p, tag: 1, idx: i })),\n    ];\n    const H = hull(tagged);\n    // The two hull edges whose endpoints belong to different shapes are the bridges.\n    const bridges = [];\n    for (let i = 0; i < H.length; i++) {\n        const u = H[i];\n        const w = H[(i + 1) % H.length];\n        if (u.tag !== w.tag) {\n            bridges.push({\n                aIdx: u.tag === 0 ? u.idx : w.idx,\n                bIdx: u.tag === 1 ? u.idx : w.idx,\n            });\n        }\n    }\n    const straightFuse = () => new Assembly({\n        geometry: shapeA.geometry.fuse(shapeB.geometry),\n        color,\n        tags: [\"shrink-wrap\", \"tangent-arc\"],\n    });\n    // Not two clean bridges (e.g. one shape inside the other, or overlapping) -\n    // fall back to a plain fuse.\n    if (bridges.length !== 2)\n        return straightFuse();\n    // Nearest points between the two outlines (the narrowest part of the gap).\n    let bestD = Infinity;\n    let naIdx = 0;\n    let nbIdx = 0;\n    for (let i = 0; i < A.length; i++) {\n        for (let j = 0; j < B.length; j++) {\n            const d = dot(sub(A[i], B[j]), sub(A[i], B[j]));\n            if (d < bestD) {\n                bestD = d;\n                naIdx = i;\n                nbIdx = j;\n            }\n        }\n    }\n    bestD = Math.sqrt(bestD);\n    if (bestD < 1e-4)\n        return straightFuse(); // touching / overlapping\n    // Slide each bridge's contacts toward the nearest point by bowDepth.\n    const b0 = bridges[0];\n    const b1 = bridges[1];\n    const ca0 = slide(A, b0.aIdx, naIdx, bowDepth);\n    const cb0 = slide(B, b0.bIdx, nbIdx, bowDepth);\n    const ca1 = slide(A, b1.aIdx, naIdx, bowDepth);\n    const cb1 = slide(B, b1.bIdx, nbIdx, bowDepth);\n    // Outer-side outline vertices for each shape (the far side, away from the gap).\n    const bVerts = arcVerts(B, cb0.f, cb1.f, nbIdx);\n    const aVerts = arcVerts(A, ca1.f, ca0.f, naIdx);\n    // Neighbouring traced points around each contact, used to orient the biarc\n    // end tangents. Orienting by the adjacent trace direction (rather than the\n    // chord between contacts) keeps the correct tangent sign even when a shape's\n    // facing edge is flat and perpendicular to the gap (e.g. a square), which\n    // otherwise produces a 90-degree cusp at the contact.\n    const prevA = aVerts.length ? aVerts[aVerts.length - 1] : ca1.pt;\n    const nextA = aVerts.length ? aVerts[0] : ca0.pt;\n    const prevB = bVerts.length ? bVerts[bVerts.length - 1] : cb0.pt;\n    const nextB = bVerts.length ? bVerts[0] : cb1.pt;\n    const tCa0 = orient(ca0.tan, sub(ca0.pt, prevA));\n    const tCb0 = orient(cb0.tan, sub(nextB, cb0.pt));\n    const tCb1 = orient(cb1.tan, sub(cb1.pt, prevB));\n    const tCa1 = orient(ca1.tan, sub(nextA, ca1.pt));\n    // Trace the full merged perimeter as a single closed sketch (no boolean, so\n    // the biarcs stay exactly tangent to each shape at the contacts):\n    //   A-contact0 --biarc--> B-contact0 --B outer arc--> B-contact1\n    //     --biarc--> A-contact1 --A outer arc--> back to A-contact0\n    const pen = replicad.draw([ca0.pt.x, ca0.pt.y]);\n    drawBiarc(pen, ca0.pt, tCa0, cb0.pt, tCb0);\n    for (const v of bVerts)\n        pen.lineTo([v.x, v.y]);\n    pen.lineTo([cb1.pt.x, cb1.pt.y]);\n    drawBiarc(pen, cb1.pt, tCb1, ca1.pt, tCa1);\n    for (const v of aVerts)\n        pen.lineTo([v.x, v.y]);\n    const merged = pen.close();\n    return new Assembly({\n        geometry: merged,\n        color,\n        tags: [\"shrink-wrap\", \"tangent-arc\"],\n        bom: [...(shapeA.bom || []), ...(shapeB.bom || [])],\n    });\n}\n"
            },
